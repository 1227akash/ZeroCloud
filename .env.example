# ZeroCloud Environment Configuration
# Web App & Signaling
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WebSocket Signaling Server (Relative or absolute URL)
# If omitted, defaults to current host's ws:// or wss:// protocol on window.location.host
NEXT_PUBLIC_WS_URL=

# WebRTC STUN/TURN Configuration (comma-separated URLs)
# Public STUN defaults provided out of the box (Google & Cloudflare)
NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun.cloudflare.com:3478

# TURN relay for symmetric NAT/cellular carrier traversal (Optional, 100% free with Metered.ca or OpenRelay)
# Sign up at https://www.metered.ca/tools/openrelay/ for free 50 GB/month TURN bandwidth
NEXT_PUBLIC_TURN_SERVERS=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_PASSWORD=

# Anti-spam & Bot Protection (Cloudflare Turnstile, optional fallback honeypot built-in)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
