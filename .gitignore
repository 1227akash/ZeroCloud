# ==========================================================
# ZeroCloud - Production .gitignore
# Prevents node_modules, build outputs, local keys, and logs
# from being uploaded to GitHub.
# ==========================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/cache

# Production & Build outputs
.next/
out/
build/
dist/

# Local Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# DO NOT IGNORE .env.example
!.env.example

# Debugging and Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Editor and IDE configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Antigravity & Agent workspace artifacts
.agents/
skills/
.gemini/
.antideploy/

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Temporary Files & Archives
*.tsbuildinfo
*.tmp
*.temp
*.zip
*.tar.gz
*.tgz
